#!/usr/bin/env bash
# Shared chat for the user, Claude Code and Codex.
# The log is .agent-chat/log.md in the nearest folder at or above the current
# one that has a .agent-chat/ folder (or $AGENT_CHAT_LOG if set).
#   chat                     follow the conversation live (Ctrl-C to stop)
#   chat --where             print the log path
#   chat <name> <message>    post; start with @claude or @codex to address one,
#                            (or @user), otherwise everyone reads it.
# Claude Code watches the log. Codex does not, so messages not from Codex and
# not addressed only to @claude are also queued into its running session.
set -euo pipefail
self=$(readlink -f "$0")
if [[ -n ${AGENT_CHAT_LOG:-} ]]; then
    log=$AGENT_CHAT_LOG
else
    d=$PWD
    until [[ -d $d/.agent-chat || $d == / ]]; do d=$(dirname "$d"); done
    [[ -d $d/.agent-chat ]] || { echo "chat: no .agent-chat/ folder here or above" >&2; exit 1; }
    log=$d/.agent-chat/log.md
fi
touch "$log"
[[ ${1:-} == --where ]] && { echo "$log"; exit 0; }

if [[ $# -eq 0 ]]; then
    exec tail -n 40 -F "$log"
fi
[[ $# -ge 2 ]] || { echo "usage: chat <name> <message>" >&2; exit 2; }
from=$1
shift
msg="$*"
printf '[%s] %s: %s\n' "$(date '+%m-%d %H:%M')" "$from" "${msg//$'\n'/$'\n'    }" >>"$log"

[[ $from == codex || $msg == @claude* || $msg == @user* ]] && exit 0
# Codex's own session: newest log started by the user (not a guardian reviewer).
session=
for f in $(ls -t ~/.codex/sessions/*/*/*/rollout-*.jsonl 2>/dev/null | head -20); do
    if head -1 "$f" | grep -q '"thread_source":"user"'; then
        session=$(head -1 "$f" | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
        break
    fi
done
if [[ -z $session ]] || ! timeout 60 codex queue --thread "$session" \
    --message "[chat from $from] $msg
(Reply: $self codex \"<text>\")" >/dev/null 2>&1; then
    echo "chat: posted, but not delivered to Codex" >&2
fi
