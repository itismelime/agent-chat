#!/usr/bin/env python3
"""bullpen command line.

  bullpen                          follow this project's chat
  bullpen add <path>               register a project folder
  bullpen post --as <name> <text>  post (--as user for yourself)
  bullpen wait --as <name>         block until a message wakes <name>
  bullpen rename --as <name> <new> take a new name; a running wait keeps working
  bullpen serve                    run the service
  bullpen mcp                      run the MCP server (agent tools)
  bullpen config ollama-url [<url>|own]  show or set the Ollama bullpen uses

post, wait and rename use the project of the working directory, or --project <id>.
"""
import argparse
import os
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE))

from bullpen.client import ApiError, Client, ServiceDown, fmt, label  # noqa: E402

CHAT = HERE / "bin" / "bullpen"
WAIT_TIMEOUT = 330  # longer than the service's 300 s long-poll
RETRY_SECONDS = 180  # a service restart (an update) takes a moment
# Claude Code stops a background command after 30 minutes by default, so a wait with no
# message ends by itself before that (no new long-poll after QUIET_SECONDS) and says to
# restart. Every restart is a model turn that re-reads the agent's whole context, which
# is what an idle agent pays for, so the wait is as long as the limit allows.
QUIET_SECONDS = 1440


def project_id(client, given):
    if given:
        return given
    project = client.resolve(os.getcwd())
    if project is None:
        sys.exit("chat: %s is not in a registered project (bullpen add <path>)" % os.getcwd())
    return project["id"]


def follow(client, pid):
    after = None
    while True:
        msgs = client.call("GET", "/api/projects/%s/messages?after=%d" % (pid, after or 0))[1]["messages"]
        for m in msgs if after is not None else msgs[-40:]:
            print(fmt(m), flush=True)
        if msgs:
            after = msgs[-1]["n"]
        elif after is None:
            after = 0
        time.sleep(2)


def wait(client, pid, name):
    path = client.agent_path(pid, name, "wait")
    down_since, started = None, time.monotonic()
    while True:
        if time.monotonic() - started > QUIET_SECONDS:
            print("No message yet (a wait ends before 30 minutes, the default limit of background commands).")
            print("Restart the wait in the background: %s wait --as %s --project %s" % (CHAT, name, pid))
            return
        try:
            status, body = client.call("GET", path, timeout=WAIT_TIMEOUT)
        except ServiceDown:
            down_since = down_since or time.monotonic()
            if time.monotonic() - down_since > RETRY_SECONDS:
                raise
            time.sleep(5)
            continue
        down_since = None
        if status == 200:
            break
    if body.get("name", name) != name:
        name = body["name"]
        print("You were renamed: you are %s now." % name)
    if body.get("personality"):
        print("Your personality: %s" % body["personality"])
    if body.get("rules"):
        print(body["rules"])
    if body["notice"] == "typed":
        print("bullpen types chat messages into this session when you are idle, so this wait is "
              "not needed: do not start it again, and stop any other bullpen wait still running.")
        return
    if body["notice"] == "removed":
        print("You were removed from this chat. Keep this wait running anyway; "
              "it only wakes you if you are added back.")
    elif body["notice"] == "added back":
        print("You were added back to the chat.")
    for m in body["messages"]:
        if m["from"] != name:
            print(fmt(m))
            print("    (%s)" % label(m, name))
    print("Restart the wait in the background: %s wait --as %s --project %s" % (CHAT, name, pid))


def main():
    # UTF-8 both ways (Windows consoles and pipes default to a code page); None under pythonw
    for stream in (sys.stdin, sys.stdout, sys.stderr):
        if stream is not None:
            stream.reconfigure(encoding="utf-8", errors="replace")
    ap = argparse.ArgumentParser(prog="bullpen", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("add").add_argument("path")
    for cmd in ("post", "wait", "rename"):
        p = sub.add_parser(cmd)
        p.add_argument("--as", dest="name", required=True)
        p.add_argument("--project")
        if cmd == "post":
            p.add_argument("text", nargs="+")
        if cmd == "rename":
            p.add_argument("new")
    sub.add_parser("serve")
    sub.add_parser("mcp")
    sub.add_parser("statusline")  # for Claude agents started from the page (bullpen/plan.py)
    cfg = sub.add_parser("config")
    cfg.add_argument("key", choices=["ollama-url"])
    cfg.add_argument("value", nargs="?")
    args = ap.parse_args()

    if args.cmd == "serve":
        from bullpen.server import main as serve
        return serve()
    if args.cmd == "statusline":
        from bullpen.plan import main as statusline
        return statusline()
    if args.cmd == "mcp":
        from bullpen.mcp import main as mcp
        return mcp()
    if args.cmd == "config":
        from bullpen import config
        if args.value is None:
            print(config.ollama_url())
            return
        try:
            config.set_ollama_url(args.value)
        except ValueError as e:
            print("chat: %s" % e, file=sys.stderr)
            sys.exit(2)
        return
    client = Client()
    try:
        if args.cmd == "add":
            body = client.call("POST", "/api/projects", {"path": os.path.abspath(args.path)})[1]
            p = body["project"]
            print("%s: %s (%s)" % ("already registered" if body["existing"] else "registered",
                                   p["name"], p["path"]))
        elif args.cmd == "post":
            client.call("POST", "/api/projects/%s/messages" % project_id(client, args.project),
                        {"from": args.name, "text": " ".join(args.text)})
        elif args.cmd == "rename":
            pid = project_id(client, args.project)
            client.call("POST", client.agent_path(pid, args.name, "rename"), {"name": args.new})
            print("renamed %s to %s; next time wait with: %s wait --as %s --project %s"
                  % (args.name, args.new.strip().lower(), CHAT, args.new.strip().lower(), pid))
        elif args.cmd == "wait":
            wait(client, project_id(client, args.project), args.name)
        else:
            follow(client, project_id(client, None))
    except ServiceDown as e:
        sys.exit(str(e))
    except ApiError as e:
        sys.exit("chat: %s" % e)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
